#
# Binlog Server REST API component test
#
# Install both the core binlog server component and the REST API
INSTALL COMPONENT 'file://component_binlog_server';
INSTALL COMPONENT 'file://component_binlog_server_rest_api';
# Verify system variables are registered (defaults: admin/admin)
SELECT @@GLOBAL.binlog_server_rest_api.bind_address;
@@GLOBAL.binlog_server_rest_api.bind_address
127.0.0.1
SELECT @@GLOBAL.binlog_server_rest_api.port;
@@GLOBAL.binlog_server_rest_api.port
8440
SELECT @@GLOBAL.binlog_server_rest_api.username;
@@GLOBAL.binlog_server_rest_api.username
admin
# Server starts automatically with default credentials
# Test: health endpoint (no auth required)
{"status":"ok"}# Test: status returns 401 without auth (curl -f returns exit code 22)
# Test: status endpoint with Basic Auth (empty array since no channels configured)
[]# Test: variables endpoint returns binlog_server variables
{"binlog_server.default_serve_channel":"","binlog_server.default_storage_uri":"","binlog_server.encryption":"OFF","binlog_server.rewrite_base_name":"","binlog_server.rewrite_file_size":"0","binlog_server.storage_root":"","binlog_server.trace_send_path":"OFF","binlog_server.user_channel_map":"","binlog_server_rest_api.bind_address":"127.0.0.1","binlog_server_rest_api.password":"admin","binlog_server_rest_api.port":"8440","binlog_server_rest_api.ssl_cert":"","binlog_server_rest_api.ssl_key":"","binlog_server_rest_api.username":"admin"}# Test: topology endpoint
{"sources":[],"channels":[],"downstream":[]}# Test: dashboard page returns HTML
1
# Uninstall (REST API first, then core)
UNINSTALL COMPONENT 'file://component_binlog_server_rest_api';
UNINSTALL COMPONENT 'file://component_binlog_server';
# Verify clean unload -- sysvar no longer exists
SELECT @@GLOBAL.binlog_server_rest_api.port;
ERROR HY000: Unknown system variable 'binlog_server_rest_api.port'
