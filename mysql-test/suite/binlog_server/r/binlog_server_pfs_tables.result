include/rpl/init_source_replica.inc
[connection master]

# ---- Configure binlog server on replica ----
[connection slave]
INSTALL COMPONENT 'file://component_binlog_server';
INSTALL PLUGIN binlog_server_relay SONAME 'BINLOG_SERVER_RELAY';

# ---- All three PFS tables exist ----
SELECT TABLE_NAME FROM information_schema.tables
WHERE TABLE_SCHEMA = 'performance_schema'
    AND TABLE_NAME LIKE 'replication_binlog_server%'
  ORDER BY TABLE_NAME;
TABLE_NAME
replication_binlog_server_archive
replication_binlog_server_status
replication_binlog_server_storage

# ---- Wire channel and start collection ----
CHANGE REPLICATION SOURCE TO
SOURCE_HOST = '127.0.0.1',
SOURCE_PORT = SOURCE_PORT,
SOURCE_USER = 'root',
SOURCE_AUTO_POSITION = 1,
BINLOG_SERVER = 1,
BINLOG_SERVER_STORAGE_URI = 'file://STORE/'
  FOR CHANNEL 'pfs_ch';
Warnings:
Note	1759	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	1760	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
START REPLICA IO_THREAD FOR CHANNEL 'pfs_ch';
include/rpl/wait_for_receiver_to_start.inc [FOR CHANNEL 'pfs_ch']

# ---- Generate traffic ----
[connection master]
CREATE TABLE t1 (id INT PRIMARY KEY, val VARCHAR(50));
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c');
include/rpl/sync_to_replica_received.inc [FOR CHANNEL 'pfs_ch']

# ---- PFS status table sees events ----
[connection slave]
include/assert.inc [events_appended > 0]
include/assert.inc [bytes_appended > 0]
include/assert.inc [write_errors = 0]

# ---- PFS storage table shows ACTIVE backend ----
include/assert.inc [at least one archive file]
include/assert.inc [total bytes on disk > 0]
include/assert.inc [STATUS is ACTIVE]

# ---- PFS archive table has file rows ----
include/assert.inc [archive table has at least 1 row]

# ---- rebuild_archive_index UDF ----
SELECT binlog_server_rebuild_archive_index('pfs_ch') >= 0 AS REBUILT_OK;
REBUILT_OK
1

# ---- Tear down ----
[connection master]
DROP TABLE t1;
include/rpl/sync_to_replica_received.inc [FOR CHANNEL 'pfs_ch']
[connection slave]
STOP REPLICA IO_THREAD FOR CHANNEL 'pfs_ch';
include/rpl/wait_for_receiver_to_stop.inc [FOR CHANNEL 'pfs_ch']
RESET REPLICA ALL FOR CHANNEL 'pfs_ch';
SET GLOBAL binlog_server.default_storage_uri = '';
SET GLOBAL binlog_server.default_serve_channel = '';
UNINSTALL PLUGIN binlog_server_relay;
UNINSTALL COMPONENT 'file://component_binlog_server';
include/rpl/deinit.inc
