include/rpl/init_source_replica.inc
[connection master]

# ---- Setup binlog server ----
[connection slave]
INSTALL COMPONENT 'file://component_binlog_server';
INSTALL PLUGIN binlog_server_relay SONAME 'BINLOG_SERVER_RELAY';
CHANGE REPLICATION SOURCE TO
SOURCE_HOST = '127.0.0.1',
SOURCE_PORT = SOURCE_PORT,
SOURCE_USER = 'root',
SOURCE_AUTO_POSITION = 1,
BINLOG_SERVER = 1,
BINLOG_SERVER_STORAGE_URI = 'file://STORE/'
  FOR CHANNEL 'meta_ch';
Warnings:
Note	1759	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	1760	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
START REPLICA IO_THREAD FOR CHANNEL 'meta_ch';
include/rpl/wait_for_receiver_to_start.inc [FOR CHANNEL 'meta_ch']

# ---- Generate events to populate archive ----
[connection master]
CREATE TABLE t1 (id INT PRIMARY KEY, val VARCHAR(50));
INSERT INTO t1 VALUES (1, 'one'), (2, 'two'), (3, 'three');
INSERT INTO t1 VALUES (4, 'four'), (5, 'five');
include/rpl/sync_to_replica_received.inc [FOR CHANNEL 'meta_ch']

# ==== GTID columns populated (binary SID-encoding) ====
[connection slave]
include/assert.inc [LAST_GTID_SET is populated (binary Previous_gtids parsed)]

# ==== rebuild_archive_index skips files with existing .meta ====
include/assert.inc [first rebuild processes files]
include/assert.inc [second rebuild returns 0 (all files already have .meta)]

# ==== Corrupt .meta does not crash the server ====
STOP REPLICA IO_THREAD FOR CHANNEL 'meta_ch';
include/rpl/wait_for_receiver_to_stop.inc [FOR CHANNEL 'meta_ch']
CHANGE REPLICATION SOURCE TO
SOURCE_HOST = '127.0.0.1',
SOURCE_PORT = SOURCE_PORT,
SOURCE_USER = 'root',
SOURCE_AUTO_POSITION = 1,
BINLOG_SERVER = 1,
BINLOG_SERVER_STORAGE_URI = 'file://STORE/'
  FOR CHANNEL 'meta_ch';
Warnings:
Note	1759	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	1760	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
START REPLICA IO_THREAD FOR CHANNEL 'meta_ch';
include/rpl/wait_for_receiver_to_start.inc [FOR CHANNEL 'meta_ch']
# Server survived corrupt .meta (no crash)
include/assert.inc [rebuild rescans file with corrupt .meta]

# ---- Tear down ----
[connection master]
DROP TABLE t1;
include/rpl/sync_to_replica_received.inc [FOR CHANNEL 'meta_ch']
[connection slave]
STOP REPLICA IO_THREAD FOR CHANNEL 'meta_ch';
include/rpl/wait_for_receiver_to_stop.inc [FOR CHANNEL 'meta_ch']
RESET REPLICA ALL FOR CHANNEL 'meta_ch';
SET GLOBAL binlog_server.default_storage_uri = '';
SET GLOBAL binlog_server.default_serve_channel = '';
UNINSTALL PLUGIN binlog_server_relay;
UNINSTALL COMPONENT 'file://component_binlog_server';
include/rpl/deinit.inc
