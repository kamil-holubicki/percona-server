include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
[connection slave]
[connection master]
[connection slave]
include/rpl/stop_replica.inc
CALL mtr.add_suppression("binlog_server.*cannot configure channel");

*** Configuring channel_a with BINLOG_SERVER=1
CHANGE REPLICATION SOURCE TO
SOURCE_HOST = '127.0.0.1',
SOURCE_PORT = SOURCE_PORT,
SOURCE_USER = 'root',
SOURCE_AUTO_POSITION = 1,
BINLOG_SERVER = 1,
BINLOG_SERVER_STORAGE_URI = 'file:///tmp/chan_a/'
  FOR CHANNEL 'channel_a';
Warnings:
Note	1759	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	1760	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.

*** Configuring channel_b with BINLOG_SERVER=1
CHANGE REPLICATION SOURCE TO
SOURCE_HOST = '127.0.0.1',
SOURCE_PORT = SOURCE_PORT,
SOURCE_USER = 'root',
SOURCE_AUTO_POSITION = 1,
BINLOG_SERVER = 1,
BINLOG_SERVER_STORAGE_URI = 'file:///tmp/chan_b/'
  FOR CHANNEL 'channel_b';
Warnings:
Note	1759	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	1760	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.

*** Verify both channels have Auto_Position=1
channel_a auto_position: 1
channel_b auto_position: 1

*** Cleanup
CHANGE REPLICATION SOURCE TO BINLOG_SERVER = 0 FOR CHANNEL 'channel_a';
CHANGE REPLICATION SOURCE TO BINLOG_SERVER = 0 FOR CHANNEL 'channel_b';
RESET REPLICA ALL FOR CHANNEL 'channel_a';
RESET REPLICA ALL FOR CHANNEL 'channel_b';
include/rpl/start_replica.inc
include/rpl/deinit.inc
