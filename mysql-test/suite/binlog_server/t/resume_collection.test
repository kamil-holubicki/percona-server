--source include/have_binlog_format_row.inc
--source suite/binlog_server/inc/have_binlog_server.inc
--source include/rpl/init_source_replica.inc

--source include/rpl/connection_replica.inc
--source suite/binlog_server/inc/binlog_server_suppressions.inc
--source include/rpl/connection_source.inc

# Test: Resume binlog collection after IO thread stop/start
#
# Verifies that:
# 1. Stopping and restarting the IO thread resumes collection correctly
# 2. No duplicate events after restart
# 3. The archive continues from where it left off

--echo
--echo *** Setting up binlog server
--let $storage_dir = $MYSQL_TMP_DIR/binlog_server_resume
--mkdir $storage_dir

--source include/rpl/connection_replica.inc
--source include/rpl/stop_replica.inc

INSTALL COMPONENT 'file://component_binlog_server';
INSTALL PLUGIN binlog_server_relay SONAME 'binlog_server_relay.so';

--replace_result $storage_dir STORAGE_DIR
eval CHANGE REPLICATION SOURCE TO
  BINLOG_SERVER = 1,
  BINLOG_SERVER_STORAGE_URI = 'file://$storage_dir/',
  SOURCE_AUTO_POSITION = 1;

START REPLICA IO_THREAD;
--let $wait_condition = SELECT COUNT(*) = 1 FROM performance_schema.replication_connection_status WHERE SERVICE_STATE = 'ON'
--source include/wait_condition.inc

--echo
--echo *** Phase 1: Write initial data
--source include/rpl/connection_source.inc
CREATE TABLE t1 (id INT PRIMARY KEY AUTO_INCREMENT, val INT);
INSERT INTO t1 (val) VALUES (1), (2), (3);

--echo
--echo *** Wait for replica to receive phase 1
--source include/rpl/connection_replica.inc
--let $wait_condition = SELECT COUNT(*) = 1 FROM performance_schema.replication_connection_status WHERE RECEIVED_TRANSACTION_SET != ''
--source include/wait_condition.inc

--echo
--echo *** Stop IO thread
STOP REPLICA IO_THREAD;
--let $wait_condition = SELECT COUNT(*) = 1 FROM performance_schema.replication_connection_status WHERE SERVICE_STATE = 'OFF'
--source include/wait_condition.inc

--echo
--echo *** Phase 2: Write more data while IO thread is stopped
--source include/rpl/connection_source.inc
INSERT INTO t1 (val) VALUES (4), (5), (6);
FLUSH BINARY LOGS;
INSERT INTO t1 (val) VALUES (7), (8), (9);

--echo
--echo *** Resume IO thread - should catch up
--source include/rpl/connection_replica.inc
START REPLICA IO_THREAD;
--let $wait_condition = SELECT COUNT(*) = 1 FROM performance_schema.replication_connection_status WHERE SERVICE_STATE = 'ON'
--source include/wait_condition.inc

# Give it a moment to catch up
--sleep 1

--echo
--echo *** Verify archive has entries
--file_exists $storage_dir/_default/binlog.index

--echo Collection resumed successfully after IO thread restart

--echo
--echo *** Cleanup
STOP REPLICA IO_THREAD;
--let $wait_condition = SELECT COUNT(*) = 1 FROM performance_schema.replication_connection_status WHERE SERVICE_STATE = 'OFF'
--source include/wait_condition.inc

CHANGE REPLICATION SOURCE TO BINLOG_SERVER = 0, SOURCE_AUTO_POSITION = 1;
UNINSTALL PLUGIN binlog_server_relay;
UNINSTALL COMPONENT 'file://component_binlog_server';

--source include/rpl/start_replica.inc
--source include/rpl/connection_source.inc
DROP TABLE t1;
--source include/rpl/sync_to_replica.inc

--force-rmdir $storage_dir

--source include/rpl/deinit.inc
