# ==== Purpose ====
#
# Comprehensive integration test combining:
#   - Two upstream sources (multi-source collection)
#   - Three downstream replicas (concurrent serving)
#   - At-rest encryption enabled on the binlog server
#   - Source binlog rotation during collection
#   - Master key rotation during collection
#   - End-to-end data verification across all replicas
#
# Topology:
#   server_1 (source A) ----> server_3 (collector/binlog_server) ----> server_4 (replica 1, src_a)
#   server_2 (source B) --/                                     \---> server_5 (replica 2, src_a)
#                                                                \---> server_6 (replica 3, src_b)
#
# Replicas 4 and 5 connect as 'repl_a' (routed to channel src_a).
# Replica 6 connects as 'repl_b' (routed to channel src_b).

--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc
--source ../inc/have_binlog_server.inc
--source include/have_component_keyring_file.inc

--let $rpl_topology = 1->2
--let $rpl_server_count = 6
--let $rpl_skip_change_master = 1
--let $rpl_skip_start_slave = 1
--let $use_gtids = 1
--source include/rpl/init.inc

--echo
--echo # ============================================================
--echo # Setup: keyring on server_3 (collector)
--echo # ============================================================

--let $rpl_connection_name = server_3
--source include/connection.inc
--source ../inc/binlog_server_suppressions.inc

--let COMPONENT_LIBRARY = `SELECT SUBSTRING_INDEX('$KEYRING_FILE_COMPONENT_LOAD', '=', -1)`
--let COMPONENT_DIR = $KEYRING_FILE_COMPONENT_DIR
--let COMPONENT_NAME = `SELECT SUBSTRING_INDEX('$COMPONENT_LIBRARY', '.', 1)`
--let CURRENT_DATADIR = `SELECT @@datadir`
--let KEYRING_FILE_PATH = `SELECT CONCAT('$MYSQLTEST_VARDIR', '/keyring_multi_source_enc')`
--let KEYRING_CONFIG_CONTENT = `SELECT CONCAT('{ "path": "', '$KEYRING_FILE_PATH','", "read_only": false }')`
--source include/keyring_tests/helper/local_keyring_create_config.inc
--let LOCAL_MANIFEST_CONTENT = `SELECT CONCAT('{ "components": "file://', '$COMPONENT_NAME', '" }')`
--source include/keyring_tests/helper/instance_create_manifest.inc

--echo
--echo # ---- Restart server_3 with keyring
--let $rpl_server_number = 3
--let $rpl_server_parameters = $KEYRING_FILE_COMPONENT_OPT
--let $rpl_omit_print_server_parameters = 1
--source include/rpl/restart_server.inc
--let $rpl_omit_print_server_parameters =

--let $rpl_connection_name = server_3
--source include/connection.inc

--echo
--echo # ============================================================
--echo # Install component and plugin on server_3
--echo # ============================================================

INSTALL COMPONENT 'file://component_binlog_server';
--replace_result $BINLOG_SERVER_RELAY BINLOG_SERVER_RELAY
eval INSTALL PLUGIN binlog_server_relay SONAME '$BINLOG_SERVER_RELAY';

--echo
--echo # ---- Enable encryption
SET GLOBAL binlog_server.encryption = ON;

--echo
--echo # ---- Create replication users
CREATE USER 'repl_a'@'%' IDENTIFIED BY 'pass_a';
GRANT REPLICATION SLAVE ON *.* TO 'repl_a'@'%';
CREATE USER 'repl_b'@'%' IDENTIFIED BY 'pass_b';
GRANT REPLICATION SLAVE ON *.* TO 'repl_b'@'%';

--echo
--echo # ---- Configure user-channel routing
SET GLOBAL binlog_server.user_channel_map = 'repl_a=src_a,repl_b=src_b';

--echo
--echo # ---- Storage directory
--let $store = $MYSQLTEST_VARDIR/tmp/binlog_server_multi_src_enc
--exec rm -rf $store
--mkdir $store

--echo
--echo # ============================================================
--echo # Configure collection channels on server_3
--echo # ============================================================

--echo
--echo # ---- Channel src_a (from server_1)
--replace_result $SERVER_MYPORT_1 SOURCE_A_PORT $store STORE
eval CHANGE REPLICATION SOURCE TO
  SOURCE_HOST = '127.0.0.1',
  SOURCE_PORT = $SERVER_MYPORT_1,
  SOURCE_USER = 'root',
  SOURCE_AUTO_POSITION = 1,
  BINLOG_SERVER = 1,
  BINLOG_SERVER_STORAGE_URI = 'file://$store/'
  FOR CHANNEL 'src_a';

--echo
--echo # ---- Channel src_b (from server_2)
--replace_result $SERVER_MYPORT_2 SOURCE_B_PORT $store STORE
eval CHANGE REPLICATION SOURCE TO
  SOURCE_HOST = '127.0.0.1',
  SOURCE_PORT = $SERVER_MYPORT_2,
  SOURCE_USER = 'root',
  SOURCE_AUTO_POSITION = 1,
  BINLOG_SERVER = 1,
  BINLOG_SERVER_STORAGE_URI = 'file://$store/'
  FOR CHANNEL 'src_b';

--echo
--echo # ---- Start collection
START REPLICA IO_THREAD FOR CHANNEL 'src_a';
--let $rpl_channel_name = 'src_a'
--source include/rpl/wait_for_receiver_to_start.inc
--let $rpl_channel_name =

START REPLICA IO_THREAD FOR CHANNEL 'src_b';
--let $rpl_channel_name = 'src_b'
--source include/rpl/wait_for_receiver_to_start.inc
--let $rpl_channel_name =

--echo
--echo # ============================================================
--echo # Phase 1: Initial data on both sources
--echo # ============================================================

--let $rpl_connection_name = server_1
--source include/connection.inc
CREATE TABLE t_a (id INT PRIMARY KEY, val VARCHAR(64)) ENGINE=InnoDB;
INSERT INTO t_a VALUES (1, 'a1'), (2, 'a2'), (3, 'a3');

--let $rpl_connection_name = server_2
--source include/connection.inc
CREATE TABLE t_b (id INT PRIMARY KEY, val VARCHAR(64)) ENGINE=InnoDB;
INSERT INTO t_b VALUES (1, 'b1'), (2, 'b2'), (3, 'b3');

--echo
--echo # ---- Wait for collection
--let $rpl_connection_name = server_3
--source include/connection.inc
--sleep 3

--echo
--echo # ============================================================
--echo # Phase 2: Source rotation + more data
--echo # ============================================================

--let $rpl_connection_name = server_1
--source include/connection.inc
FLUSH BINARY LOGS;
INSERT INTO t_a VALUES (4, 'a4_after_rotate'), (5, 'a5_after_rotate');

--let $rpl_connection_name = server_2
--source include/connection.inc
FLUSH BINARY LOGS;
INSERT INTO t_b VALUES (4, 'b4_after_rotate'), (5, 'b5_after_rotate');

--echo
--echo # ---- Wait for rotated data to be collected
--let $rpl_connection_name = server_3
--source include/connection.inc
--sleep 3

--echo
--echo # ============================================================
--echo # Phase 3: Master key rotation + more data
--echo # ============================================================

--let $rpl_connection_name = server_3
--source include/connection.inc

--echo # ---- Rotate key for src_a
SELECT binlog_server_rotate_encryption_key('src_a');

--echo # ---- Rotate key for src_b
SELECT binlog_server_rotate_encryption_key('src_b');

--let $rpl_connection_name = server_1
--source include/connection.inc
INSERT INTO t_a VALUES (6, 'a6_after_key_rotate'), (7, 'a7_after_key_rotate');

--let $rpl_connection_name = server_2
--source include/connection.inc
INSERT INTO t_b VALUES (6, 'b6_after_key_rotate'), (7, 'b7_after_key_rotate');

--echo
--echo # ---- Another source rotation after key rotation
--let $rpl_connection_name = server_1
--source include/connection.inc
FLUSH BINARY LOGS;
INSERT INTO t_a VALUES (8, 'a8_final');

--let $rpl_connection_name = server_2
--source include/connection.inc
FLUSH BINARY LOGS;
INSERT INTO t_b VALUES (8, 'b8_final');

--echo
--echo # ---- Wait for all data to be collected
--let $rpl_connection_name = server_3
--source include/connection.inc
--sleep 3

--echo
--echo # ============================================================
--echo # Configure downstream replicas (server_4, server_5, server_6)
--echo # ============================================================

--echo
--echo # ---- server_4 (replica 1): connects as repl_a -> gets src_a
--let $rpl_connection_name = server_4
--source include/connection.inc

--replace_result $SERVER_MYPORT_3 COLLECTOR_PORT
eval CHANGE REPLICATION SOURCE TO
  SOURCE_HOST = '127.0.0.1',
  SOURCE_PORT = $SERVER_MYPORT_3,
  SOURCE_USER = 'repl_a',
  SOURCE_PASSWORD = 'pass_a',
  SOURCE_AUTO_POSITION = 1;

START REPLICA;
--source include/rpl/wait_for_replica_to_start.inc

--echo
--echo # ---- server_5 (replica 2): connects as repl_a -> gets src_a
--let $rpl_connection_name = server_5
--source include/connection.inc

--replace_result $SERVER_MYPORT_3 COLLECTOR_PORT
eval CHANGE REPLICATION SOURCE TO
  SOURCE_HOST = '127.0.0.1',
  SOURCE_PORT = $SERVER_MYPORT_3,
  SOURCE_USER = 'repl_a',
  SOURCE_PASSWORD = 'pass_a',
  SOURCE_AUTO_POSITION = 1;

START REPLICA;
--source include/rpl/wait_for_replica_to_start.inc

--echo
--echo # ---- server_6 (replica 3): connects as repl_b -> gets src_b
--let $rpl_connection_name = server_6
--source include/connection.inc

--replace_result $SERVER_MYPORT_3 COLLECTOR_PORT
eval CHANGE REPLICATION SOURCE TO
  SOURCE_HOST = '127.0.0.1',
  SOURCE_PORT = $SERVER_MYPORT_3,
  SOURCE_USER = 'repl_b',
  SOURCE_PASSWORD = 'pass_b',
  SOURCE_AUTO_POSITION = 1;

START REPLICA;
--source include/rpl/wait_for_replica_to_start.inc

--echo
--echo # ============================================================
--echo # Phase 4: Verify replicas received all data
--echo # ============================================================

--echo
--echo # ---- Wait for replicas to catch up
--let $rpl_connection_name = server_4
--source include/connection.inc
let $wait_timeout = 60;
let $wait_condition = SELECT COUNT(*) = 8 FROM t_a;
--source include/wait_condition.inc

--let $rpl_connection_name = server_5
--source include/connection.inc
let $wait_timeout = 60;
let $wait_condition = SELECT COUNT(*) = 8 FROM t_a;
--source include/wait_condition.inc

--let $rpl_connection_name = server_6
--source include/connection.inc
let $wait_timeout = 60;
let $wait_condition = SELECT COUNT(*) = 8 FROM t_b;
--source include/wait_condition.inc

--echo
--echo # ---- Verify server_4 (replica 1 - src_a data)
--let $rpl_connection_name = server_4
--source include/connection.inc
SELECT COUNT(*) AS row_count FROM t_a;
SELECT id, val FROM t_a ORDER BY id;

--echo
--echo # ---- Verify server_5 (replica 2 - src_a data, identical to replica 1)
--let $rpl_connection_name = server_5
--source include/connection.inc
SELECT COUNT(*) AS row_count FROM t_a;
SELECT id, val FROM t_a ORDER BY id;

--echo
--echo # ---- Verify server_6 (replica 3 - src_b data)
--let $rpl_connection_name = server_6
--source include/connection.inc
SELECT COUNT(*) AS row_count FROM t_b;
SELECT id, val FROM t_b ORDER BY id;

--echo
--echo # ---- Verify PFS shows both channels encrypted
--let $rpl_connection_name = server_3
--source include/connection.inc
SELECT CHANNEL_NAME, EVENTS_APPENDED > 0 AS has_events
  FROM performance_schema.replication_binlog_server_status
  WHERE CHANNEL_NAME IN ('src_a', 'src_b')
  ORDER BY CHANNEL_NAME;

--echo
--echo # ============================================================
--echo # Teardown
--echo # ============================================================

--echo # ---- Stop downstream replicas
--let $rpl_connection_name = server_4
--source include/connection.inc
STOP REPLICA;
--source include/rpl/wait_for_replica_to_stop.inc
RESET REPLICA ALL;

--let $rpl_connection_name = server_5
--source include/connection.inc
STOP REPLICA;
--source include/rpl/wait_for_replica_to_stop.inc
RESET REPLICA ALL;

--let $rpl_connection_name = server_6
--source include/connection.inc
STOP REPLICA;
--source include/rpl/wait_for_replica_to_stop.inc
RESET REPLICA ALL;

--echo # ---- Stop collection channels
--let $rpl_connection_name = server_3
--source include/connection.inc

--let $rpl_channel_name = 'src_a'
STOP REPLICA IO_THREAD FOR CHANNEL 'src_a';
--source include/rpl/wait_for_receiver_to_stop.inc
--let $rpl_channel_name =

--let $rpl_channel_name = 'src_b'
STOP REPLICA IO_THREAD FOR CHANNEL 'src_b';
--source include/rpl/wait_for_receiver_to_stop.inc
--let $rpl_channel_name =

RESET REPLICA ALL FOR CHANNEL 'src_a';
RESET REPLICA ALL FOR CHANNEL 'src_b';

SET GLOBAL binlog_server.user_channel_map = '';
SET GLOBAL binlog_server.encryption = OFF;

--echo # ---- Kill dump threads
--disable_query_log
let $kill_id = `SELECT COALESCE(MIN(ID),0) FROM information_schema.PROCESSLIST WHERE COMMAND IN ('Binlog Dump','Binlog Dump GTID')`;
while ($kill_id)
{
  --eval KILL CONNECTION $kill_id
  --sleep 0.2
  let $kill_id = `SELECT COALESCE(MIN(ID),0) FROM information_schema.PROCESSLIST WHERE COMMAND IN ('Binlog Dump','Binlog Dump GTID')`;
}
--enable_query_log

let $wait_timeout = 60;
let $wait_condition =
  SELECT COUNT(*) = 0 FROM information_schema.PROCESSLIST
  WHERE COMMAND IN ('Binlog Dump','Binlog Dump GTID');
--source include/wait_condition.inc

--disable_query_log
--let $_dummy = `SELECT SLEEP(1)`
--enable_query_log

DROP USER 'repl_a'@'%';
DROP USER 'repl_b'@'%';

UNINSTALL PLUGIN binlog_server_relay;
UNINSTALL COMPONENT 'file://component_binlog_server';

--exec rm -rf $store

--echo # ---- Drop tables on sources
--let $rpl_connection_name = server_1
--source include/connection.inc
DROP TABLE t_a;

--let $rpl_connection_name = server_2
--source include/connection.inc
DROP TABLE t_b;

--echo # ---- Drop tables on replicas (they have them from replication)
--let $rpl_connection_name = server_4
--source include/connection.inc
--disable_warnings
DROP TABLE IF EXISTS t_a;
--enable_warnings

--let $rpl_connection_name = server_5
--source include/connection.inc
--disable_warnings
DROP TABLE IF EXISTS t_a;
--enable_warnings

--let $rpl_connection_name = server_6
--source include/connection.inc
--disable_warnings
DROP TABLE IF EXISTS t_b;
--enable_warnings

--echo # ---- Cleanup keyring
--let $rpl_connection_name = server_3
--source include/connection.inc
--let CURRENT_DATADIR = `SELECT @@datadir`
--source include/keyring_tests/helper/instance_remove_manifest.inc
--source include/keyring_tests/helper/local_keyring_file_remove.inc

--let $rpl_server_number = 3
--let $rpl_server_parameters =
--source include/rpl/restart_server.inc

--let $rpl_skip_sync = 1
--let $rpl_skip_stop_slave = 1
--source include/rpl/deinit.inc
