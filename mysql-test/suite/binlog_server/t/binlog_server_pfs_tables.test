# ==== Purpose ====
#
# Phase 4: Verify that the three PFS tables for binlog server
# observability are created when the component is installed and
# return correct data after events are collected.
#
# PFS tables tested:
#   performance_schema.replication_binlog_server_status
#   performance_schema.replication_binlog_server_storage
#   performance_schema.replication_binlog_server_archive

--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc
--source ../inc/have_binlog_server.inc

--let $use_gtids = 1
--let $rpl_skip_change_master = 1
--let $rpl_skip_start_slave = 1
--source include/rpl/init_source_replica.inc

--echo
--echo # ---- Configure binlog server on replica ----
--source include/rpl/connection_replica.inc
--source ../inc/binlog_server_suppressions.inc

--let $store = $MYSQLTEST_VARDIR/tmp/bs_pfs_test
--exec rm -rf $store
--mkdir $store

INSTALL COMPONENT 'file://component_binlog_server';
--replace_result $BINLOG_SERVER_RELAY BINLOG_SERVER_RELAY
eval INSTALL PLUGIN binlog_server_relay SONAME '$BINLOG_SERVER_RELAY';

--echo
--echo # ---- All three PFS tables exist ----
SELECT TABLE_NAME FROM information_schema.tables
  WHERE TABLE_SCHEMA = 'performance_schema'
    AND TABLE_NAME LIKE 'replication_binlog_server%'
  ORDER BY TABLE_NAME;

--echo
--echo # ---- Wire channel and start collection ----
--replace_result $SERVER_MYPORT_1 SOURCE_PORT $store STORE
eval CHANGE REPLICATION SOURCE TO
  SOURCE_HOST = '127.0.0.1',
  SOURCE_PORT = $SERVER_MYPORT_1,
  SOURCE_USER = 'root',
  SOURCE_AUTO_POSITION = 1,
  BINLOG_SERVER = 1,
  BINLOG_SERVER_STORAGE_URI = 'file://$store/'
  FOR CHANNEL 'pfs_ch';

START REPLICA IO_THREAD FOR CHANNEL 'pfs_ch';
--let $rpl_channel_name = 'pfs_ch'
--source include/rpl/wait_for_receiver_to_start.inc
--let $rpl_channel_name =

--echo
--echo # ---- Generate traffic ----
--source include/rpl/connection_source.inc
CREATE TABLE t1 (id INT PRIMARY KEY, val VARCHAR(50));
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c');
--let $rpl_channel_name = 'pfs_ch'
--source include/rpl/sync_to_replica_received.inc
--let $rpl_channel_name =

--echo
--echo # ---- PFS status table sees events ----
--source include/rpl/connection_replica.inc

--let $events = `SELECT EVENTS_APPENDED FROM performance_schema.replication_binlog_server_status WHERE CHANNEL_NAME = 'pfs_ch'`
--let $bytes = `SELECT BYTES_APPENDED FROM performance_schema.replication_binlog_server_status WHERE CHANNEL_NAME = 'pfs_ch'`
--let $write_errors = `SELECT WRITE_ERRORS FROM performance_schema.replication_binlog_server_status WHERE CHANNEL_NAME = 'pfs_ch'`

--let $assert_text = events_appended > 0
--let $assert_cond = $events > 0
--source include/assert.inc

--let $assert_text = bytes_appended > 0
--let $assert_cond = $bytes > 0
--source include/assert.inc

--let $assert_text = write_errors = 0
--let $assert_cond = $write_errors = 0
--source include/assert.inc

--echo
--echo # ---- PFS storage table shows ACTIVE backend ----
--let $files = `SELECT FILE_COUNT FROM performance_schema.replication_binlog_server_storage WHERE CHANNEL_NAME = 'pfs_ch'`
--let $disk_bytes = `SELECT TOTAL_BYTES_ON_DISK FROM performance_schema.replication_binlog_server_storage WHERE CHANNEL_NAME = 'pfs_ch'`
--let $status = `SELECT STATUS FROM performance_schema.replication_binlog_server_storage WHERE CHANNEL_NAME = 'pfs_ch'`

--let $assert_text = at least one archive file
--let $assert_cond = $files >= 1
--source include/assert.inc

--let $assert_text = total bytes on disk > 0
--let $assert_cond = $disk_bytes > 0
--source include/assert.inc

--let $assert_text = STATUS is ACTIVE
--let $assert_cond = "$status" = "ACTIVE"
--source include/assert.inc

--echo
--echo # ---- PFS archive table has file rows ----
--let $archive_rows = `SELECT COUNT(*) FROM performance_schema.replication_binlog_server_archive WHERE CHANNEL_NAME = 'pfs_ch'`
--let $assert_text = archive table has at least 1 row
--let $assert_cond = $archive_rows >= 1
--source include/assert.inc

--echo
--echo # ---- rebuild_archive_index UDF ----
SELECT binlog_server_rebuild_archive_index('pfs_ch') >= 0 AS REBUILT_OK;

--echo
--echo # ---- Tear down ----
--source include/rpl/connection_source.inc
DROP TABLE t1;
--let $rpl_channel_name = 'pfs_ch'
--source include/rpl/sync_to_replica_received.inc
--let $rpl_channel_name =

--source include/rpl/connection_replica.inc
STOP REPLICA IO_THREAD FOR CHANNEL 'pfs_ch';
--let $rpl_channel_name = 'pfs_ch'
--source include/rpl/wait_for_receiver_to_stop.inc
--let $rpl_channel_name =
RESET REPLICA ALL FOR CHANNEL 'pfs_ch';
SET GLOBAL binlog_server.default_storage_uri = '';
SET GLOBAL binlog_server.default_serve_channel = '';

UNINSTALL PLUGIN binlog_server_relay;
UNINSTALL COMPONENT 'file://component_binlog_server';

--exec rm -rf $store

--let $rpl_skip_sync = 1
--let $rpl_skip_stop_slave = 1
--source include/rpl/deinit.inc
