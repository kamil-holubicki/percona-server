# ==== Purpose ====
#
# Verify that the binlog server serving path correctly handles:
#
#   1. XA PREPARE transactions (XA_PREPARE_LOG_EVENT as GTID skip terminator)
#   2. Binlog file rotation on the source (STOP events in non-terminal files
#      are suppressed and do not disconnect the downstream replica)
#   3. A second downstream joining after the first has already consumed the
#      archive (tests GTID skipping of XA transactions that are already in the
#      replica's executed set)
#
# Topology:
#   server_1 (source) ---> server_2 (binlog server) ---> server_3 (replica)
#
# The test does:
#   - Regular DML on the source
#   - An XA transaction on the source
#   - FLUSH BINARY LOGS (causes rotation + STOP in non-terminal file)
#   - More DML after the rotation
#   - Verifies the downstream replica has all data

--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc
--source ../inc/have_binlog_server.inc

--let $rpl_topology = 1->2->3
--let $rpl_server_count = 3
--let $rpl_skip_change_master = 1
--let $rpl_skip_start_slave = 1
--let $use_gtids = 1
--source include/rpl/init.inc

--echo
--echo # ============================================================
--echo # Configure server_2 as the binlog server
--echo # ============================================================

--let $rpl_connection_name = server_2
--source include/connection.inc
--source ../inc/binlog_server_suppressions.inc

--let $store = $MYSQLTEST_VARDIR/tmp/binlog_server_xa_rotation
--exec rm -rf $store
--mkdir $store

INSTALL COMPONENT 'file://component_binlog_server';
--replace_result $BINLOG_SERVER_RELAY BINLOG_SERVER_RELAY
eval INSTALL PLUGIN binlog_server_relay SONAME '$BINLOG_SERVER_RELAY';

SET GLOBAL binlog_server.default_serve_channel = 'upstream';

--replace_result $SERVER_MYPORT_1 SOURCE_PORT $store STORE
eval CHANGE REPLICATION SOURCE TO
  SOURCE_HOST = '127.0.0.1',
  SOURCE_PORT = $SERVER_MYPORT_1,
  SOURCE_USER = 'root',
  SOURCE_AUTO_POSITION = 1,
  BINLOG_SERVER = 1,
  BINLOG_SERVER_STORAGE_URI = 'file://$store/'
  FOR CHANNEL 'upstream';

START REPLICA IO_THREAD FOR CHANNEL 'upstream';
--let $rpl_channel_name = 'upstream'
--source include/rpl/wait_for_receiver_to_start.inc
--let $rpl_channel_name =

--echo
--echo # ============================================================
--echo # Configure server_3 as a plain replica of server_2
--echo # ============================================================
--let $rpl_connection_name = server_3
--source include/connection.inc

--replace_result $SERVER_MYPORT_2 COLLECTOR_PORT
eval CHANGE REPLICATION SOURCE TO
  SOURCE_HOST = '127.0.0.1',
  SOURCE_PORT = $SERVER_MYPORT_2,
  SOURCE_USER = 'root',
  SOURCE_AUTO_POSITION = 1;

START REPLICA;
--source include/rpl/wait_for_replica_to_start.inc

--echo
--echo # ============================================================
--echo # Phase 1: Regular DML on source
--echo # ============================================================
--let $rpl_connection_name = server_1
--source include/connection.inc

CREATE TABLE t1 (id INT PRIMARY KEY, val VARCHAR(50)) ENGINE = InnoDB;
INSERT INTO t1 VALUES (1, 'before_xa');

--echo
--echo # ============================================================
--echo # Phase 2: XA transaction on source
--echo # ============================================================
XA START 'xa_test_1';
INSERT INTO t1 VALUES (2, 'xa_row_a');
INSERT INTO t1 VALUES (3, 'xa_row_b');
XA END 'xa_test_1';
XA PREPARE 'xa_test_1';
XA COMMIT 'xa_test_1';

--echo
--echo # ============================================================
--echo # Phase 3: Force binlog rotation (writes STOP + new file)
--echo # ============================================================
FLUSH BINARY LOGS;

--echo
--echo # ============================================================
--echo # Phase 4: More DML after rotation
--echo # ============================================================
INSERT INTO t1 VALUES (4, 'after_rotation_1');
INSERT INTO t1 VALUES (5, 'after_rotation_2');

--echo
--echo # ============================================================
--echo # Phase 5: Another XA transaction after rotation
--echo # ============================================================
XA START 'xa_test_2';
INSERT INTO t1 VALUES (6, 'xa2_row');
XA END 'xa_test_2';
XA PREPARE 'xa_test_2';
XA COMMIT 'xa_test_2';

INSERT INTO t1 VALUES (7, 'final_row');

--echo
--echo # ---- Sync binlog server IO thread
--let $sync_slave_connection = server_2
--let $rpl_channel_name = 'upstream'
--source include/rpl/sync_to_replica_received.inc
--let $rpl_channel_name =

--echo
--echo # ---- Sync downstream replica
--let $rpl_connection_name = server_1
--source include/connection.inc
--let $sync_slave_connection = server_3
--source include/rpl/sync_to_replica.inc

--echo
--echo # ============================================================
--echo # Verify: downstream has all 7 rows
--echo # ============================================================
--let $rpl_connection_name = server_3
--source include/connection.inc

SELECT COUNT(*) AS expected_7 FROM t1;
SELECT id, val FROM t1 ORDER BY id;

--echo
--echo # ============================================================
--echo # Verify: GTID sets match (source == replica)
--echo # ============================================================
--let $rpl_connection_name = server_1
--source include/connection.inc
--let $source_gtid = `SELECT @@GLOBAL.gtid_executed`

--let $rpl_connection_name = server_3
--source include/connection.inc
--let $replica_gtid = `SELECT @@GLOBAL.gtid_executed`

--let $assert_text = Replica GTID set should match source
--let $assert_cond = "$source_gtid" = "$replica_gtid"
--source include/assert.inc

--echo
--echo # ============================================================
--echo # Verify: replication survived the rotation (implies STOP was suppressed)
--echo # ============================================================
--let $rpl_connection_name = server_3
--source include/connection.inc
--let $assert_text = Replica IO thread should still be running (STOP did not disconnect)
--let $io_running = query_get_value(SHOW REPLICA STATUS, Replica_IO_Running, 1)
--let $assert_cond = "$io_running" = "Yes"
--source include/assert.inc

--echo
--echo # ============================================================
--echo # Tear down
--echo # ============================================================
--let $rpl_connection_name = server_3
--source include/connection.inc
STOP REPLICA;
--source include/rpl/wait_for_replica_to_stop.inc
RESET REPLICA ALL;

--let $rpl_connection_name = server_2
--source include/connection.inc

--let $rpl_channel_name = 'upstream'
STOP REPLICA IO_THREAD FOR CHANNEL 'upstream';
--source include/rpl/wait_for_receiver_to_stop.inc
--let $rpl_channel_name =

RESET REPLICA ALL FOR CHANNEL 'upstream';

SET GLOBAL binlog_server.default_serve_channel = '';

--let $kill_id = `SELECT COALESCE(MIN(ID),0) FROM information_schema.PROCESSLIST WHERE COMMAND IN ('Binlog Dump','Binlog Dump GTID')`
if ($kill_id)
{
  --disable_query_log
  --eval KILL CONNECTION $kill_id
  --enable_query_log
}

let $wait_timeout = 60;
let $wait_condition =
  SELECT COUNT(*) = 0 FROM information_schema.PROCESSLIST
  WHERE COMMAND IN ('Binlog Dump','Binlog Dump GTID');
--source include/wait_condition.inc

--disable_query_log
--let $_dummy = `SELECT SLEEP(1)`
--enable_query_log

UNINSTALL PLUGIN binlog_server_relay;
UNINSTALL COMPONENT 'file://component_binlog_server';

--exec rm -rf $store

--let $rpl_connection_name = server_1
--source include/connection.inc
DROP TABLE t1;

--let $rpl_connection_name = server_3
--source include/connection.inc
DROP TABLE t1;

--let $rpl_skip_sync = 1
--let $rpl_skip_stop_slave = 1
--source include/rpl/deinit.inc
